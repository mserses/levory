# ServisZeka portalı ortam değişkenleri — .env.local olarak kopyalayın.
# Not: VITE_ ile başlayan her değer derlenen JavaScript'e gömülür; buraya ASLA gizli bilgi yazmayın.

# API kök adresi (backend'de SZ_CORS_ORIGINS bu portalın kökenini içermeli)
VITE_API_BASE_URL=http://localhost:8000

# Kimlik doğrulama kipi: oidc (varsayılan) | dev
# dev: küçük bir giriş formu `dev:<kullanıcı>:<roller>` belirteci üretir; backend'de
# SZ_ENVIRONMENT=development ve SZ_AUTH_MODE=dev olmalı.
VITE_AUTH_MODE=dev

# OIDC (Authorization Code + PKCE) — VITE_AUTH_MODE=oidc iken zorunlu
#   Keycloak: https://sso.ornek.com/realms/serviszeka
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=serviszeka-portal
VITE_OIDC_SCOPE=openid profile email

# Tarih/saat gösterimi için saat dilimi (varsayılan Europe/Istanbul)
VITE_TIME_ZONE=Europe/Istanbul
