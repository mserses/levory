{
  "name": "serviszeka-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ServisZeka web portalı (self-servis, agent çalışma alanı, onaylar, bilgi bankası, yönetim)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "gen:openapi": "cd .. && uv run python -m serviszeka.openapi_export > portal/openapi.json",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "sync:api": "npm run gen:openapi && npm run gen:api && npm run gen:taxonomy",
    "gen:taxonomy": "node scripts/copy-taxonomy.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.80.7",
    "oidc-client-ts": "3.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.15.32",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "msw": "2.10.2",
    "openapi-typescript": "7.8.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
