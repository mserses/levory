# ServisZeka ortam değişkenleri — bu dosyayı .env olarak kopyalayın.
# Tüm ayarlar SZ_ önekiyle okunur (bkz. src/serviszeka/config.py).
# UYARI: Gerçek parolaları/anahtarları asla depoya eklemeyin.

# --- Ortam ---
# development | test | staging | production. Varsayılan production (güvenli).
SZ_ENVIRONMENT=production

# --- Kimlik doğrulama (OIDC bearer JWT: Keycloak / Microsoft Entra ID) ---
# oidc (varsayılan) | dev. dev kipinde `Authorization: Bearer dev:<kullanıcı>:<rol1,rol2>`
# kabul edilir ve imza DOĞRULANMAZ; yalnızca SZ_ENVIRONMENT=development iken çalışır,
# başka ortamda uygulama açılmayı reddeder. Yerel deneme için:
#   SZ_ENVIRONMENT=development
#   SZ_AUTH_MODE=dev
SZ_AUTH_MODE=oidc
# Belirteç yayıncısı (iss). OIDC kipinde zorunlu; yoksa uygulama açılmaz.
#   Keycloak: https://sso.ornek.com/realms/serviszeka
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
SZ_AUTH_ISSUER=
# Beklenen hedef kitle (aud). OIDC kipinde zorunlu.
#   Keycloak: istemci kimliği (audience mapper ile), Entra: api://<uygulama-id> veya istemci kimliği
SZ_AUTH_AUDIENCE=
# Boşsa <issuer>/.well-known/openid-configuration içindeki jwks_uri kullanılır.
SZ_AUTH_JWKS_URL=
# Rol talebi (noktalı yol). Boşsa Keycloak realm_access.roles + resource_access.<aud>.roles
# ve Entra roles birlikte okunur. Roller: agent, approver, admin, requester (self-servis),
# change_manager, cab; Faz 3: ai_agent (yapay zekâ hizmet sorumlusu -> aktör ai:<azp/appid>).
SZ_AUTH_ROLES_CLAIM=
# Kullanıcı adı talebi; yoksa upn, email, sub sırasıyla denenir.
SZ_AUTH_USERNAME_CLAIM=preferred_username
# exp/nbf saat kayması toleransı (saniye) ve JWKS istek zaman aşımı (saniye)
SZ_AUTH_LEEWAY_SECONDS=30
SZ_AUTH_HTTP_TIMEOUT=3.0

# --- CORS (web portalı) ---
# Tarayıcıdan API'ye erişebilecek kökenler; virgülle ayrılmış. Boşsa CORS kapalı.
#   SZ_CORS_ORIGINS=http://localhost:5173
SZ_CORS_ORIGINS=

# --- Veritabanı ---
# Yerel geliştirme için SQLite; docker compose bunu Postgres adresiyle ezer.
SZ_DATABASE_URL=sqlite+aiosqlite:///./serviszeka.db
# Örnek Postgres: postgresql+asyncpg://serviszeka:serviszeka@localhost:5432/serviszeka
# Açılışta tabloları create_all ile kur (geliştirme). Üretimde false; şema
# `alembic upgrade head` ile kurulur/güncellenir.
SZ_AUTO_CREATE_SCHEMA=true

# docker compose Postgres servisi için (isteğe bağlı)
POSTGRES_DB=serviszeka
POSTGRES_USER=serviszeka
POSTGRES_PASSWORD=degistirin

# --- LLM (Anthropic) ---
# Sağlayıcı: anthropic (varsayılan) | fake. fake, API anahtarı olmadan deterministik
# (anahtar kelimeye dayalı) sınıflandırma ve değişiklik risk anlatısı döndürür; yalnızca SZ_ENVIRONMENT=development
# iken kabul edilir, aksi halde uygulama açılmaz (yerel deneme ve E2E testleri için).
SZ_LLM_PROVIDER=anthropic
# Anthropic API anahtarı; boşsa LLM çağrıları açık bir hata verir.
SZ_ANTHROPIC_API_KEY=
# Akıl yürütme gerektiren işler için model (sınıflandırma, kök neden vb.)
SZ_LLM_REASONING_MODEL=claude-opus-5-5
# Hızlı/ucuz işler için model (özetleme, etiketleme vb.)
SZ_LLM_FAST_MODEL=claude-haiku-5-5

# --- Yapay zekâ yönetişimi ---
# Bu güven eşiğinin altındaki ajan kararları insana yönlendirilir (0.0 - 1.0).
SZ_AI_CONFIDENCE_THRESHOLD=0.75
# Gölge mod: true iken ajanlar yalnızca önerir, hiçbir eylemi uygulamaz.
SZ_AI_SHADOW_MODE=true

# Nöbetçi bildirim webhook'u (P1/P2 yükseltme onayı bekleyince); boşsa yalnızca loglanır
SZ_ONCALL_WEBHOOK_URL=
# Kalıcı bildirim kuyruğu (notification_outbox): en fazla deneme (sonra "dead") ve üstel geri
# çekilme tabanı (saniye; deneme n için taban * 2^(n-1), en fazla 1 saat).
SZ_NOTIFICATION_MAX_ATTEMPTS=5
SZ_NOTIFICATION_BACKOFF_SECONDS=30
# Kuyruk saklama süresi (gün; zamanlayıcı işi outbox_retention): gönderilmiş ve ölü satırlar toplu
# silinir. Açık olayın SLA tekilleştirme satırları (sla:*) olay açıkken korunur.
SZ_OUTBOX_RETENTION_DAYS=30
SZ_OUTBOX_DEAD_RETENTION_DAYS=90
# Arka plan zamanlayıcısı (kuyruk gönderimi, eylem isteği süre aşımı, SLA ihlal/risk uyarısı,
# bekleyen hizmet talepleri). Birden fazla kopyada her işi tek kopya çalıştırır (DB kira kaydı).
SZ_SCHEDULER_ENABLED=true
SZ_SCHEDULER_TICK_SECONDS=15
# İş onayı bekleyen hizmet talebinin geçerlilik süresi (saat); dolunca talep reddedilir.
SZ_REQUEST_APPROVAL_TTL_HOURS=168

# --- Otomasyon (Faz 3): araçlar, MCP, eylem istekleri ---
# R2/R3 araç çağrısı (ve politikanın otomatik uygulamadığı R1) bir eylem isteği (ActionRequest)
# açar; insan onayı bu süre (saat) içinde gelmezse istek "expired" olur ve yürütülemez. 1-720.
SZ_ACTION_REQUEST_TTL_HOURS=24

# --- Faz 3: yapay zekâ ajanı hizmet sorumluları (ai_agent; MCP sunucusu /mcp) ---
# Ayrı bir ortam değişkeni yoktur: MCP istemcisi (ör. Claude) kimlik sağlayıcıda kendi istemcisiyle
# (client credentials) belirteç alır ve belirteçte `ai_agent` rolü taşır. ServisZeka böyle bir
# belirteci her zaman `ai:<azp|appid|client_id>` aktörüne ve YALNIZCA ai_agent rolüne indirger:
# insan REST uçlarını kullanamaz, onay veremez; R2/R3 araçlar eylem isteği açar.
#   Keycloak: gizli istemci "servis-ajani" + hizmet hesabı + realm/istemci rolü ai_agent
#             (belirteçte azp=servis-ajani -> aktör ai:servis-ajani)
#   Entra ID: uygulama kaydı + uygulama rolü "ai_agent" (allowedMemberTypes: Application),
#             yönetici onayıyla atanır (belirteçte roles=["ai_agent"], appid -> ai:<appid>)
# Aynı belirteçte insan rolleri (agent/admin...) olsa bile yok sayılır; ajana insan rolü vermeyin.

# --- Faz 3: bağlayıcılar (Entra ID / Microsoft 365 Graph / Teams) ---
# none: bağlayıcı yok (identity.*, mailbox.*, license.*, notify.send_to_user/post_to_channel 503);
# fake: bellek içi sahte dizin, yalnızca SZ_ENVIRONMENT=development (yerel deneme / E2E);
# graph: Microsoft Graph (client credentials) + Teams gelen webhook. Ayrıntı: docs/faz3.md.
SZ_CONNECTOR_PROVIDER=none
# Ayrı sağlayıcı seçimi (boş/yorumda = SZ_CONNECTOR_PROVIDER'dan türetilir; çelişirse açılış reddedilir).
# Kimlik: graph (Entra ID + M365 posta/lisans) | keycloak (yalnızca kimlik) | memory (sahte dizin,
# yalnızca development). Zorunlu ayarlar eksikse uygulama açılmaz (hangi SZ_ ayarı eksik, yazar).
# SZ_IDENTITY_PROVIDER=keycloak
# Bildirim (notify.send_to_user / post_to_channel): teams (SZ_IDENTITY_PROVIDER=graph +
# SZ_GRAPH_SENDER_MAILBOX zorunlu) | slack (SZ_SLACK_BOT_TOKEN ya da SZ_SLACK_WEBHOOK_URL zorunlu) |
# log (bildirim bağlayıcısı yok: notify.send_* 503; nöbetçi uyarısı log / SZ_ONCALL_WEBHOOK_URL).
# Keycloak'ta ikincil e-posta yoktur: geçici parola bildirimi (identity.reset_password) teslim edilemez.
# SZ_NOTIFIER_PROVIDER=slack
# Entra ID uygulama kaydı (client credentials). Gizli değeri asla koda/depoya yazmayın.
SZ_GRAPH_TENANT_ID=
SZ_GRAPH_CLIENT_ID=
SZ_GRAPH_CLIENT_SECRET=
SZ_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
SZ_GRAPH_LOGIN_URL=https://login.microsoftonline.com
# Graph/Teams HTTP zaman aşımı (saniye)
SZ_GRAPH_TIMEOUT=10
# notify.send_to_user e-postalarının gönderildiği posta kutusu (Mail.Send uygulama izni)
SZ_GRAPH_SENDER_MAILBOX=
# Teams kanal adı -> gelen webhook URL'si (JSON). Örn: {"servis-masasi": "https://..."}
SZ_TEAMS_WEBHOOK_URLS={}
# identity.add_to_group için standart grup izin listesi (grup kimlikleri, virgülle): bu gruplara
# ekleme R1 (politika izin verirse otomatik); listede olmayan/ayrıcalıklı gruplar R3. Boş liste
# = her gruba ekleme R3 (insansız grup erişimi yok). Graph'ta grup nesne kimliği (GUID) yazılır;
# sahte dizinde (yerel deneme / E2E) örnek:
#   SZ_IDENTITY_STANDARD_GROUPS=sg-yazilim-standart,sg-vpn-kullanicilari,m365-ekip-proje-x
# Yalnızca ayrıcalıksız, iş onayı gerektirmeyen grupları ekleyin; listeye eklenen her grup Faz 3
# kapısı ölçümünde (evals/run_automation_eval.py) insansız sayılabilir hâle gelir.
SZ_IDENTITY_STANDARD_GROUPS=
# Her zaman ayrıcalıklı (R3) sayılan gruplar (Graph'ta isAssignableToRole=true gruplar da ayrıcalıklı)
SZ_IDENTITY_PRIVILEGED_GROUPS=
# --- Faz 3: Keycloak kimlik bağlayıcısı (SZ_CONNECTOR_PROVIDER=keycloak; ayrıntı docs/faz3.md) ---
# Admin REST API; hizmet hesabı etkin gizli istemci (realm-management: view-users, query-groups,
# manage-users). Yalnızca `identity` kurulur. Keycloak <17 için sunucu adresi /auth ile biter.
SZ_KEYCLOAK_SERVER_URL=
SZ_KEYCLOAK_REALM=
SZ_KEYCLOAK_CLIENT_ID=
# Gizli değeri asla koda/depoya yazmayın.
SZ_KEYCLOAK_CLIENT_SECRET=
# Yöneticinin kullanıcı adını taşıyan kullanıcı özniteliği (Keycloak 24+: kullanıcı profilinde tanımlı olmalı)
SZ_KEYCLOAK_MANAGER_ATTRIBUTE=manager
# İkincil (kişisel) e-posta özniteliği: geçici parola yalnızca bu adrese gider (SMTP ile).
# Keycloak 24+: öznitelik kullanıcı profilinde tanımlı ve yalnızca yöneticilerce düzenlenebilir olmalı.
SZ_KEYCLOAK_SECONDARY_EMAIL_ATTRIBUTE=secondary_email
# --- SMTP e-posta bildiricisi (posta sağlayıcısı olmayan Keycloak yığını; connectors/smtp.py) ---
# Host + gönderen doluysa etkin: kullanıcı bildirimi ve geçici parolanın ikincil adrese teslimi.
SZ_SMTP_HOST=
SZ_SMTP_PORT=587
SZ_SMTP_SENDER=
SZ_SMTP_USERNAME=
# Gizli değeri asla koda/depoya yazmayın.
SZ_SMTP_PASSWORD=
SZ_SMTP_STARTTLS=true
# Örtük TLS (SMTPS, port 465); STARTTLS ile birlikte açılamaz.
SZ_SMTP_SSL=false
# TLS'siz SMTP yalnızca geliştirmede (SZ_ENVIRONMENT=development) ve bu bayrakla; aksi halde açılış reddedilir.
SZ_SMTP_ALLOW_PLAINTEXT=false
# --- Faz 3: Slack (isteğe bağlı; ayrıntı docs/faz3.md) ---
# Bot belirteci (xoxb-..., gizli; kapsamlar: chat:write, im:write, users:read, users:read.email).
# Tanımlıysa notify.send_to_user (DM) / notify.post_to_channel Slack'e gider; hassas bildirim gitmez.
SZ_SLACK_BOT_TOKEN=
# Kanal kimlikleri: notify.post_to_channel "default" / "oncall"; nöbet kanalı nöbetçi uyarısını da alır
SZ_SLACK_DEFAULT_CHANNEL=
SZ_SLACK_ONCALL_CHANNEL=
# İsteğe bağlı gelen webhook URL'si (gizli, tek kanal): bot belirteci yoksa kanal mesajı/nöbetçi uyarısı
SZ_SLACK_WEBHOOK_URL=

# --- Değişiklik yönetimi (Faz 2) ---
# Normal değişikliğin yetkilendirilmesi (authorize -> scheduled) için gereken en az CAB onayı.
# Tek red değişikliği reddeder; talep eden ve uygulayıcının oyu kabul edilmez. Acil (ECAB)
# değişiklikte bu ayar kullanılmaz: change_manager rolünde 1 onay gerekir. En az 1.
SZ_CAB_MIN_APPROVALS=2
# Değişiklik risk ajanı (POST /changes/{id}/assess) SZ_LLM_FAST_MODEL'i kullanır; riski
# yükselten öneri yalnızca SZ_AI_SHADOW_MODE=false ve güven >= SZ_AI_CONFIDENCE_THRESHOLD
# iken uygulanır, riski düşüren öneri her zaman change_manager onayı ister.

# --- ServiceNow entegrasyonu ---
# Örn. https://ornek.service-now.com
SZ_SERVICENOW_INSTANCE_URL=
SZ_SERVICENOW_USERNAME=
SZ_SERVICENOW_PASSWORD=

# --- Jira Service Management entegrasyonu ---
# Örn. https://ornek.atlassian.net
SZ_JIRA_BASE_URL=
SZ_JIRA_EMAIL=
# Atlassian API token (hesap ayarlarından oluşturulur)
SZ_JIRA_API_TOKEN=
# Hizmet masası (service desk) kimliği
SZ_JIRA_SERVICE_DESK_ID=
# İstek türü kimliği (boşsa hizmet masasının ilk istek türü)
SZ_JIRA_REQUEST_TYPE_ID=

# Senkron çakışma politikası: manual | remote_wins | local_wins
SZ_SYNC_CONFLICT_POLICY=manual

# --- Faz 4: izleme ve olay yönetimi (POST /events/alertmanager, /events/generic) ---
# İnsan eylemleri: POST /events/groups/{id}/acknowledge (R1) ve /silence (R2, insan onayı)
# Paylaşılan gizli (boşsa webhook'lar 401 ile kapalı). Alertmanager: http_config.authorization
# credentials ile `Authorization: Bearer <gizli>`; diğerleri HMAC-SHA256 imza (docs/faz4.md)
SZ_EVENTS_WEBHOOK_SECRET=
# Gövde sınırı (bayt) ve zaman damgası / yinelenen teslimat penceresi (sn)
SZ_EVENTS_MAX_BODY_BYTES=1048576
SZ_EVENTS_REPLAY_WINDOW_SECONDS=300
# Etiket -> CI eşleme kuralları (JSON dizisi; boşsa varsayılan: ci_id, ci, instance, service, job)
# SZ_EVENTS_CI_MAPPING=[{"label":"instance","match":"name","strip_port":true},{"label":"host","match":"external_ref","key":"prometheus"}]
# Bağıntı penceresi (dk), çırpınma eşiği / penceresi (dk), olay açan en düşük önem
SZ_EVENTS_CORRELATION_WINDOW_MINUTES=30
SZ_EVENTS_FLAP_THRESHOLD=4
SZ_EVENTS_FLAP_WINDOW_MINUTES=60
SZ_EVENTS_INCIDENT_MIN_SEVERITY=high
# Olay fırtınası: son bir saatte izlemeden bu kadar olay açıldıysa ajan P3-P5 açmaz (P1/P2 onaya gider)
SZ_EVENTS_MAX_INCIDENTS_PER_HOUR=20

# --- Faz 4 sürekli iyileştirme (CSI kaydı, agents/improvement.py; zamanlayıcı işi csi_review) ---
# Sinyal penceresi (gün; önceki eşit pencereyle karşılaştırılır)
SZ_CSI_WINDOW_DAYS=30
# Uygulama sonrası KPI ölçüm penceresi (gün; elle açılan iyileştirmelerin varsayılanı — CSI ajanının
# önerilerinde ölçüm penceresi sinyal penceresine, SZ_CSI_WINDOW_DAYS, eşittir: taban aynı uzunlukta)
SZ_CSI_MEASURE_DAYS=30
# Reddedilen / kapanan sinyalin yeniden önerilmeden önce beklediği süre (gün)
SZ_CSI_COOLDOWN_DAYS=30

# --- Web portalı (docker compose `portal` servisi) ---
# Tarayıcının API'ye ulaştığı adres (pakete gömülür ve CSP connect-src'ye yazılır)
PORTAL_API_BASE_URL=http://localhost:8000
# oidc | dev (dev yalnızca yerel deneme; backend'de SZ_AUTH_MODE=dev gerekir)
PORTAL_AUTH_MODE=oidc
# OIDC yayıncısı ve public client (PKCE); yayıncının kökeni CSP'ye ayrıca verilir
PORTAL_OIDC_AUTHORITY=
PORTAL_OIDC_CLIENT_ID=serviszeka-portal
#   örn. https://sso.ornek.com
PORTAL_OIDC_ORIGIN=
